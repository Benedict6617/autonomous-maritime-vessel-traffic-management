# Database (SQLite by default, swap to Postgres DSN in production)
DATABASE_URL=sqlite:///./vts.db

# Port configuration
PORT_NAME=Harborview Regional Port
PORT_UNLOCODE=USHVW
PORT_TIMEZONE=America/New_York

# Regulatory
CUSTOMS_ADVANCE_NOTICE_HOURS=24
IMO_PRE_ARRIVAL_NOTICE_HOURS=24

# App
APP_ENV=development
LOG_LEVEL=INFO
